{
  "configurations": [
    {
      "name": "macOS",
      "includePath": [
        "${workspaceFolder}/**",
        "/opt/homebrew/opt/qt/include",
        "/opt/homebrew/opt/qt/include/QtWidgets",
        "/opt/homebrew/opt/qt/include/QtCore",
        "/opt/homebrew/opt/qt/include/QtGui"
      ],
      "defines": [],
      "macFrameworkPath": [
        "/System/Library/Frameworks",
        "/Library/Frameworks"
      ],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-arm64"  // change to macos-clang-x64 if on Intel Mac
    }
  ],
  "version": 4
}
